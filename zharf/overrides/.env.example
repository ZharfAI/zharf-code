# Optional: Zharf Connect source builds.
#
# Zharf Connect (remote access through a relay, accounts on the phone apps) is not deployed yet,
# so these stay empty and builds have the cloud features turned off. Never copy upstream's
# values here: they are another company's production identities.
# Do not add server-side secrets to this file.

# T3CODE_CLERK_PUBLISHABLE_KEY=
# T3CODE_CLERK_JWT_TEMPLATE=
# T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds.
# T3CODE_APPLE_TEAM_ID=ABC1234567
# T3CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/zharf-code.provisionprofile
# T3CODE_CLERK_PASSKEY_RP_DOMAINS=

# The relay, once deployed (infra/relay).
# T3CODE_RELAY_URL=

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# T3CODE_HOSTED_APP_URL=

# Public, ingest-only mobile OpenTelemetry configuration.
# T3CODE_MOBILE_OTLP_TRACES_URL=
# T3CODE_MOBILE_OTLP_TRACES_DATASET=
# T3CODE_MOBILE_OTLP_TRACES_TOKEN=
